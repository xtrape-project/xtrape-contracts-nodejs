{
  "name": "@xtrape/contracts",
  "version": "0.8.17",
  "description": "TypeScript contracts and Zod schemas for the Xtrape Platform, Connector, and Panel wire protocols.",
  "keywords": [
    "xtrape",
    "panel",
    "opstage",
    "contracts",
    "zod",
    "connector-sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://forgejo.xtrape.com/xtrape-project/xtrape-contracts-nodejs.git"
  },
  "homepage": "https://forgejo.xtrape.com/xtrape-project/xtrape-contracts-nodejs#readme",
  "bugs": {
    "url": "https://forgejo.xtrape.com/xtrape-project/xtrape-contracts-nodejs/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "spec",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "prepack": "pnpm build",
    "test": "vitest run && node --test tests/publish-summarize.check.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.0.2",
    "secretlint": "13.0.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "license": "Apache-2.0",
  "pnpm": {
    "overrides": {
      "fast-uri@<3.1.7": "^3.1.7"
    }
  }
}
